# Postgres connection used by the API, the seeder and the simulator.
# Local docker compose default:
DATABASE_URL=postgres://cdop:cdop@localhost:5433/cdop
# Optional separate connection for LISTEN/NOTIFY (Supabase: use the SESSION pooler, not port 6543).
# DATABASE_LISTEN_URL=

# Port the API listens on inside the process / container.
PORT=3000
# Public origin used to build absolute links in HAL responses and CloudEvents `source`.
PUBLIC_BASE_URL=http://localhost:3000

LOG_LEVEL=info
# Run migrations + seed automatically on boot when the database is empty (docker compose quickstart).
SEED_ON_START=true
# Deterministic seed for the synthetic dataset.
CDOP_SEED=2026

# Bootstrap admin API key (role admin). Generate one with `pnpm keys:new`.
ADMIN_API_KEY=
# Which affordances (_templates) anonymous callers see: all | none
AFFORDANCES_FOR_ANONYMOUS=all
# Comma-separated CORS origins, or *
CORS_ORIGINS=*
# Anonymous rate limit, requests per minute per IP
RATE_LIMIT_ANON_RPM=120

# Lifecycle simulator
SIM_ENABLED=false
SIM_TICK_SECONDS=60
SIM_ACTIONS_PER_TICK=3

# Webhook delivery (M2)
WEBHOOK_DELIVERY_ENABLED=true
