            "type": "string",
            "enum": [
              "ex_ante",
              "ex_post",
              "conversion",
              "buffer"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pre_issuance",
              "pending_issuance",
              "issuing",
              "complete",
              "failed"
            ]
          },
          "verification_id": {
            "type": "string",
            "minLength": 1
          },
          "validation_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit_of_measure": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuance_id",
          "project_id",
          "kind",
          "status",
          "quantity",
          "unit_of_measure"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "issuance_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "on_hold",
              "buffer",
              "retired",
              "cancelled",
              "expired"
            ]
          },
          "status_reason": {
            "type": "string"
          },
          "serial_number": {
            "type": "string",
            "minLength": 1
          },
          "status_history": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "effective_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "actor": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "account_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string"
                },
                "from_state": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "pending",
                        "active",
                        "on_hold",
                        "buffer",
                        "retired",
                        "cancelled",
                        "expired"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to_state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "active",
                    "on_hold",
                    "buffer",
                    "retired",
                    "cancelled",
                    "expired"
                  ]
                },
                "is_current": {
                  "type": "boolean"
                }
              },
              "required": [
                "event_id",
                "sequence",
                "effective_at",
                "recorded_at",
                "actor",
                "action",
                "from_state",
                "to_state",
                "is_current"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "unit_id",
          "project_id",
          "issuance_id",
          "status",
          "serial_number",
          "status_history"
        ],
        "additionalProperties": false
      }
    }
