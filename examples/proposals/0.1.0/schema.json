  "required": [
    "profile",
    "status",
    "project",
    "verifications",
    "validations",
    "issuances",
    "units"
  ],
  "additionalProperties": false,
  "$id": "https://cdop.rethinkcarbon.co.uk/v2/proposals/0.1.0/schema",
  "title": "Rethink identity and lifecycle proposal 0.1.0",
  "description": "Experimental review profile for FB-010 and FB-012–015. Cross-record links and history continuity are checked by the companion validator."
}
