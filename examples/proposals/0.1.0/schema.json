{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "rethink-proposal-0.1.0"
    },
    "status": {
      "type": "string",
      "const": "proposal"
    },
    "project": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "object",
          "properties": {
            "registry_id": {
              "type": "string",
              "minLength": 1
            },
            "registry_project_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "registry_id",
            "registry_project_id"
          ],
          "additionalProperties": false
        },
        "lifecycle_stage": {
          "type": "string",
          "enum": [
            "draft",
            "listed",
            "registered",
            "validated",
            "verified",
            "retired",
            "withdrawn",
            "rejected"
          ]
        },
        "is_on_hold": {
          "type": "boolean"
        },
        "authorization": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "not_reported"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "registry_status": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "vocabulary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "vocabulary"
          ],
          "additionalProperties": false
        },
        "status_history": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "effective_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "actor": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "account_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              },
              "from_state": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to_state": {
                "type": "string",
                "minLength": 1
              },
              "is_current": {
                "type": "boolean"
              },
              "lifecycle_stage": {
                "type": "string",
                "enum": [
                  "draft",
                  "listed",
                  "registered",
                  "validated",
                  "verified",
                  "retired",
                  "withdrawn",
                  "rejected"
                ]
              }
            },
            "required": [
              "event_id",
              "sequence",
              "effective_at",
              "recorded_at",
              "actor",
              "action",
              "from_state",
              "to_state",
              "is_current",
              "lifecycle_stage"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "project_name",
        "registry",
        "lifecycle_stage",
        "is_on_hold",
        "authorization",
        "registry_status",
        "status_history"
      ],
      "additionalProperties": false
