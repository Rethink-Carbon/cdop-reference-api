{
  "name": "@cdop/api",
  "version": "0.1.0",
  "private": true,
  "description": "CDOP reference API: HAL + HAL-FORMS REST, OpenAPI 3.1, MCP server, CloudEvents stream, synthetic registry data and lifecycle simulator.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:types": "kysely-codegen --dialect postgres --url env(DATABASE_URL) --default-schema cdop --out-file src/db/types.generated.ts --camel-case=false --numeric-parser number --singularize=false",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "sim": "tsx --env-file-if-exists=.env src/sim/cli.ts",
    "keys:new": "tsx --env-file-if-exists=.env src/db/keys-cli.ts",
    "openapi:build": "tsx scripts/build-openapi.ts",
    "openapi:check": "tsx scripts/build-openapi.ts --check",
    "explorer:fetch": "node scripts/fetch-explorer.mjs"
  },
  "dependencies": {
    "@cdop/schemas": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "geodesy": "^2.4.0",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "swagger-ui-dist": "^5.33.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/geodesy": "^2.2.8",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
